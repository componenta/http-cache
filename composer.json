{
    "name": "componenta/http-cache",
    "description": "Route-aware HTTP response cache middleware for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "componenta/config": "^4.0",
        "componenta/http": "^1.0",
        "componenta/router": "^3.1",
        "php": "^8.5.13",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpbench/phpbench": "^1.7.1",
        "phpstan/phpstan": "^2.2.14",
        "phpstan/phpstan-phpunit": "^2.0.19",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Http\\Cache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit tests --display-deprecations --display-notices --display-phpunit-notices --fail-on-phpunit-notice",
        "phpstan": "@php vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@phpstan",
            "@test"
        ],
        "bench": "@php vendor/bin/phpbench run --report=aggregate"
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "abandoned": {
                "ignore": {
                    "doctrine/annotations": {
                        "on-block": false,
                        "reason": "Transitive development-only dependency required by PHPBench 1.7; benchmarks use native attributes. No security advisory exemption."
                    }
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\Cache\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev",
            "dev-spec/attribute-callbacks-2026-11-26": "2.0.x-dev"
        }
    }
}
